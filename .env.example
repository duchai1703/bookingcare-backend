# Server
PORT=8080

# Database — PostgreSQL 16
DB_HOST=localhost
DB_USERNAME=bookingcare_user
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=bookingcare
DB_PORT=5432
DB_DIALECT=postgres

# Email (SRS Section 2.4 – Constraint #8)
EMAIL_APP_USERNAME=your_email@gmail.com
EMAIL_APP_PASSWORD=YOUR_EMAIL_APP_PASSWORD


# JWT Secret
JWT_SECRET=YOUR_JWT_SECRET

# Frontend URL (cho CORS và email link)
URL_REACT=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════
# [Phase 11] VNPay Payment Integration
# ═══════════════════════════════════════════════════════════════════════
VNP_TMN_CODE=0BQ5CEW5
VNP_HASH_SECRET=YOUR_VNP_HASH_SECRET
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_RETURN_URL=http://localhost:3000/payment-result
VNP_IPN_URL=https://blouse-unhelpful-sadly.ngrok-free.dev/api/v1/payment/vnpay-ipn

# [Phase 11] Security Secrets
API_CRON_SECRET=YOUR_CRON_SECRET
# Cần tối thiểu 64 bytes cho fallback secret
RECEIPT_FALLBACK_SECRET=YOUR_RECEIPT_SECRET

# --- CẤU HÌNH AI CHATBOT (PHASE 12) ---
AI_CHATBOT_ENABLED=true
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
